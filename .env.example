# Dinu's development deployment. Production uses befitting-lyrebird-846.
CONVEX_DEPLOYMENT=dev:disciplined-squid-496 # team: julien-newman, project: dinu-app
PUBLIC_CONVEX_URL=https://disciplined-squid-496.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://disciplined-squid-496.convex.site

# Clerk development application (the secret is used only by SvelteKit's server).
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Configure these separately on the matching Convex backend:
# CLERK_SECRET_KEY=<same development application's secret key>
# CLERK_JWT_ISSUER_DOMAIN=https://<your-development-app>.clerk.accounts.dev
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# APP_URL=http://localhost:5173
# See docs/clerk-auth.md for JWT claims, webhook setup, and rollout.

# CSM booking completion: set this only on the matching Convex backend.
# CAL_API_KEY=<organizer-owned Cal API key, server-side only>
# CAL_WEBHOOK_SECRET=<random secret shared with this deployment's Cal webhook>
# Register https://<deployment>.convex.site/cal/webhook in Cal.com.
# Subscribe to Booking Created, Requested, Rescheduled, Cancelled and Rejected.
# Use the default payload (version 2021-10-20).
# See docs/delegation.md for activation and account attribution.

# Invitation and approval Loops values belong on the Convex backend.
# Configure each company approval recipient in Settings.
# Configure using `npx convex env set NAME value` on the intended deployment:
# LOOPS_API_KEY=<server-side Loops API key>
# LOOPS_INVITATION_ID=<published invitation template ID from npm run email:setup>
# LOOPS_APPROVAL_ID=<published approval template ID from npm run email:setup>
# LOOPS_DECISION_ID=<published completed-review template ID from npm run email:setup>
# APP_URL=https://app.dinu.co
# See docs/email-delivery.md for repo-owned LMX templates, setup and activation.

# HubSpot integration: these are Convex backend values, never PUBLIC_ variables.
# HUBSPOT_CLIENT_ID=<OAuth app client ID>
# HUBSPOT_CLIENT_SECRET=<OAuth app client secret; set through the Convex dashboard>
# HUBSPOT_REDIRECT_URI=http://localhost:5173/api/hubspot/callback
# HUBSPOT_SCOPES=oauth crm.objects.deals.read crm.objects.deals.write files.read files.write
# HUBSPOT_ENABLED=false
# HUBSPOT_DELIVERY_ENABLED=false
# APP_URL=http://localhost:5173
# Enable installation only after credentials are configured; enable delivery after provider validation.
# See docs/hubspot.md and hubspot/README.md.
